<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://example.com/movies/v1"
           targetNamespace="http://example.com/movies/v1"
           elementFormDefault="qualified">

    <xs:complexType name="Movie">
        <xs:sequence>
            <xs:element name="id" type="xs:int"/>
            <xs:element name="title" type="xs:string"/>
            <xs:element name="year" type="xs:int"/>
            <xs:element name="director" type="xs:string"/>
            <xs:element name="subgenre" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Request wrapper: name must equal the operation name (document/literal wrapped). -->
    <xs:element name="searchMovies">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="keyword" type="xs:string" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="searchMoviesResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="movie" type="tns:Movie" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
